# Copy to .env.local and fill in. Never commit real values.
# Local development: run `pnpm db:start`, then copy the values from `pnpm exec supabase status`
# (API_URL, ANON_KEY, SERVICE_ROLE_KEY).

# Supabase API URL (local: http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key. Safe in the browser; access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Server-side only (SPEC section 7): never expose it to the client or
# prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
