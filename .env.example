# Copy to .env.local and fill in. Never commit real values.
# Local development: run `pnpm db:start`, then copy the values from `pnpm exec supabase status`
# (API_URL, ANON_KEY, SERVICE_ROLE_KEY).

# Supabase API URL (local: http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key. Safe in the browser; access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Server-side only (SPEC section 7): never expose it to the client or
# prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google Sign-In for the LOCAL Supabase stack only (read by supabase/config.toml when you run
# `pnpm db:start`; export them in your shell, or put them in supabase/.env, which is ignored by
# git). Use the "staging+local" OAuth client (docs/setup/google-oauth.md, docs/setup/supabase-auth.md). Without them the
# stack still starts and only the real Google round-trip fails. Staging and production set
# these in the Supabase dashboard instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# M7.2 Web Push (docs/setup/push.md). The public VAPID key (public by design, built into the
# browser bundle). Empty: the settings screen says push is not set up.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional: where the test push goes instead of <NEXT_PUBLIC_SUPABASE_URL>/functions/v1/push
# (the E2E tests point it at a mock). Leave empty everywhere else.
PUSH_FUNCTION_URL=
